# Server-only values for the daily market history cron. Never expose these in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-secret-key
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters
# Required only to enable SEC EDGAR filing capture. Use an app name and a monitored contact email.
SEC_USER_AGENT=StockDashboard your-email@example.com
# Required only to enable FRED macro observation capture. Keep it server-only.
FRED_API_KEY=replace-with-your-fred-api-key
# Optional, explicitly opt-in model research. The API key is server-only and must never use a VITE_/NEXT_PUBLIC_ prefix.
# Keep the toggle false until the key, model id and daily request ceiling have all been reviewed.
DEEPSEEK_RESEARCH_ENABLED=false
# A second explicit gate for sending immutable research packets to a third-party model provider.
DEEPSEEK_RESEARCH_DATA_APPROVED=false
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# Optional HTTPS OpenAI-compatible chat-completions URL. Leave unset to use the official DeepSeek endpoint.
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# Current production/local model id. Compatible OpenAI Chat Completions gateways may use the same name.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_DAILY_REQUESTS=1
DEEPSEEK_MAX_OUTPUT_TOKENS=900
# Optional, one-time compatibility check for an HTTPS model gateway. This request contains fixed probe JSON only, never research data.
# Keep false unless a maintainer explicitly approves the outbound probe; one attempt is reserved per probe version and model.
DEEPSEEK_GATEWAY_COMPATIBILITY_ENABLED=false
# Optional. Lets the homepage "生成 AI 解读" button call the model with a sanitized five-section skeleton.
# The model writes a separate explanation panel; it does not replace the template.
# Does not enable close-of-day research recaps. Keep false unless a maintainer wants that button live.
DEEPSEEK_BEGINNER_READING_ENABLED=false
